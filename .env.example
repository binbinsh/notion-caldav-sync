# Copy to .env (gitignored). Use your own private Notion integration.
DATABASE_URL=postgres://sync:CHANGE_ME@127.0.0.1:5432/notion_sync
# Generate once: openssl rand -hex 32. Keep it with PostgreSQL backups.
DATA_ENCRYPTION_KEY=
NOTION_TOKEN=
NOTION_SOURCE_IDS=
APPLE_ID=
APPLE_APP_PASSWORD=
CALENDAR_HREF=
ADMIN_TOKEN=
WEBHOOK_SETUP_TOKEN=
# Optional: preserve an existing verified Notion webhook without re-verification.
WEBHOOK_VERIFICATION_TOKEN=
CALENDAR_TIMEZONE=Asia/Taipei
DESCRIPTION_PROPERTY=Description
STATUS_EMOJI_STYLE=emoji
HOST=127.0.0.1
PORT=8787
# Disabled until the preview and first sync have been reviewed.
SYNC_INTERVAL_SECONDS=0
