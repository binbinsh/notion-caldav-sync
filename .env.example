# Optional for OAuth; useful when selecting among multiple Cloudflare accounts.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STATE_NAMESPACE=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_SYNC_QUEUE=notion-caldav-sync-jobs
CLOUDFLARE_SYNC_DLQ=notion-caldav-sync-jobs-dlq
# Optional when using `uv run pywrangler login`; required for headless deployment.
CLOUDFLARE_API_TOKEN=
NOTION_TOKEN=
APPLE_ID=
APPLE_APP_PASSWORD=
ADMIN_TOKEN=
WEBHOOK_SETUP_TOKEN=
STATUS_EMOJI_STYLE=emoji
# Optional. Leave blank to use notion-caldav-sync.<account-subdomain>.workers.dev.
WORKER_CUSTOM_DOMAIN=
DEPLOYMENT_MODE=personal

# Hosted multi-user mode. These values are needed only when DEPLOYMENT_MODE=hosted.
PUBLIC_BASE_URL=https://notion-caldav-sync.example.workers.dev
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
CREDENTIAL_VAULT_KEY=
HOSTED_WEBHOOK_SETUP_TOKEN=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
CLERK_SIGN_IN_URL=
CLERK_AUTHORIZED_PARTIES=https://notion-caldav-sync.example.workers.dev
HOSTED_ADMIN_USER_IDS=
HOSTED_SYNC_INTERVAL_MINUTES=30
HOSTED_CRON_BATCH_LIMIT=10
HOSTED_BETA_USER_LIMIT=100
