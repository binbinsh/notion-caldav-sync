{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notion-caldav-sync",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "SYNC", "class_name": "SyncObject" }] },
  "migrations": [{ "tag": "v0.9.0", "new_sqlite_classes": ["SyncObject"] }],
  "vars": {
    "NOTION_SOURCE_IDS": "",
    "CALENDAR_HREF": "",
    "CALENDAR_TIMEZONE": "Asia/Taipei",
    "DESCRIPTION_PROPERTY": "Description",
    "STATUS_EMOJI_STYLE": "emoji"
  },
  // Enable after preview and the first successful reconciliation.
  "triggers": { "crons": [] }
}
