{
  "name": "notion-caldav-sync",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Self-hosted two-way Notion and CalDAV synchronization on Workers/D1 or Node/PostgreSQL",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch dist/main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-e2e.mjs",
    "check": "pnpm check:repository && pnpm typecheck && pnpm test && pnpm test:workers",
    "build": "node scripts/build.mjs",
    "start": "node dist/main.mjs",
    "check:repository": "node scripts/check-repository.mjs",
    "test:workers": "node scripts/test-workers.mjs",
    "deploy:check": "wrangler deploy --dry-run --config wrangler.jsonc --outdir artifacts/worker-deploy"
  },
  "dependencies": {
    "fast-xml-parser": "5.9.3",
    "ical-generator": "10.1.0",
    "ical.js": "2.2.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/pg": "8.15.5",
    "esbuild": "0.28.1",
    "miniflare": "5.20261006.0-alpha",
    "typescript": "5.9.3",
    "wrangler": "4.148.0"
  },
  "exports": {
    "./core": "./src/core/index.ts",
    "./providers": "./src/providers.ts"
  }
}
