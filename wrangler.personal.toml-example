name = "notion-caldav-sync"
main = "src/app/worker.py"
compatibility_date = "2026-09-20"
compatibility_flags = ["python_workers"]
workers_dev = false
preview_urls = false

[[routes]]
pattern = "${WORKER_CUSTOM_DOMAIN}"
custom_domain = true

[[kv_namespaces]]
binding = "STATE"
id = "${CLOUDFLARE_STATE_NAMESPACE}"

[vars]
STATUS_EMOJI_STYLE = "${STATUS_EMOJI_STYLE}"

[triggers]
crons = ["*/30 * * * *"]
